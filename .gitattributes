# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Godot text formats
*.gd    text eol=lf
*.tscn  text eol=lf
*.tres  text eol=lf
*.godot text eol=lf
*.cfg   text eol=lf

# Binary assets
*.png   binary
*.jpg   binary
*.webp  binary
*.svg   binary
*.ogg   binary
*.wav   binary
*.mp3   binary
*.ttf   binary
*.otf   binary
